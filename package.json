{
  "name": "offer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-first desktop workspace for job applications, interview timelines, and sourced intelligence.",
  "author": "Sakura7596",
  "license": "MIT",
  "main": "electron/main.mjs",
  "homepage": "https://github.com/Sakura7596/offer",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:sites": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "app:start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/workspace-model.test.mjs tests/data-store.test.mjs tests/company-identity.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "desktop:start": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "desktop:dist:x64": "npm run build && electron-builder --mac dmg --x64 --publish never"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "build": {
    "appId": "io.github.sakura7596.offer",
    "productName": "offer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "offer ${version}"
    },
    "artifactName": "offer-${version}-mac-${arch}.${ext}"
  }
}
